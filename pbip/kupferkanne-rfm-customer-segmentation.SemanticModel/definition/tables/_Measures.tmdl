	/// Static Page 1 title for the Customer Count by Recency histogram.
	measure 'Title Recency Histogram' =
			
			"Customer Count by Recency (days since last order)"
		displayFolder: 06 - Formatting & Regional
		lineageTag: a14d3ad6-98ef-4c47-9657-1abe9997bcc7

	/// Static Page 1 title for the Customer Distribution by Segment donut chart.
	measure 'Title Segment Distribution' =
			
			"Customer Distribution by Segment"
		displayFolder: 06 - Formatting & Regional
		lineageTag: c0101998-c04b-4dc9-be87-0c27944744ec

	/// Static Page 3 title for the Top 15 Products by Revenue chart.
	measure 'Title Top Products' =
			
			"Top 15 Products by Revenue"
		displayFolder: 06 - Formatting & Regional
		lineageTag: 05162935-121c-4559-ae1c-4da30e483ddb

	/// Static Page 3 title for the Profitability by Category, Brand and Product matrix.
	measure 'Title Profitability Matrix' =
			
