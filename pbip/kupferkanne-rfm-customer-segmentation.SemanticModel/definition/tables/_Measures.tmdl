	/// Static Page 2 title for the Recommended Strategy by Segment table.
	measure 'Title Segment Strategy' =
			
			"Recommended Strategy by Segment"
		displayFolder: 06 - Formatting & Regional
		lineageTag: 0829b033-8613-4738-9f95-7ec695c8ea7c

	/// Static Page 2 title for the frequency vs monetary scatter chart by segment.
	measure 'Title Segment Scatter' =
			
			"Frequency × Monetary by Segment"
		displayFolder: 06 - Formatting & Regional
		lineageTag: af2d1d43-a10f-4dda-b59d-98910cf207f7

	/// Static Page 5 title for the Cohort Retention Heatmap.
	measure 'Title Cohort Retention' =
			
			"Cohort Retention Heatmap"
		displayFolder: 06 - Formatting & Regional
		lineageTag: 912de8d9-5c61-485a-a621-9d3c8efe6ab7

	/// Static Page 1 title for the Revenue by Segment bar chart.
	measure 'Title Revenue by Segment' =
			
			"Revenue by Segment"
		displayFolder: 06 - Formatting & Regional
