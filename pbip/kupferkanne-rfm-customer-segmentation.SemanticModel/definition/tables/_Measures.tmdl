table _Measures
	lineageTag: a3a134bb-f7a7-4964-8501-b8188dcbce0a

	/// Total order-grain revenue from sales_curated; the P&L revenue figure (EUR).
	measure 'Total Revenue' =
			
			SUM ( sales_curated[Order Value] )
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: e27ebb98-0bbc-4b38-8092-7937821c8158

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Distinct customers with at least one order; excludes never-ordered records.
	measure 'Total Customers' =
			
			CALCULATE (
			    DISTINCTCOUNT ( dim_Customer[Customer ID] ),
			    NOT ISBLANK ( dim_Customer[Order Count] )
			)
		formatString: #,##0
		displayFolder: 01 - Core KPIs
		lineageTag: f5bf0588-f124-4262-8ba2-497f9c4f00d1

	/// Total order count, summed from dim_Customer[Order Count].
	measure 'Total Orders' =
			
			SUM ( dim_Customer[Order Count] )
		formatString: #,##0
		displayFolder: 01 - Core KPIs
		lineageTag: c588885a-88aa-4b8e-a349-0984f195d34b

	/// Average revenue per order: Total Revenue / Total Orders.
	measure 'Avg Order Value' =
			
			DIVIDE (
			    [Total Revenue],
			    [Total Orders],
			    0
			)
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: 35d673c0-8155-4dcb-a3f7-a95bd46d3a22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average lifetime revenue per customer: Total Revenue / Total Customers.
	measure 'Avg Customer LTV' =
			
			DIVIDE (
			    [Total Revenue],
			    [Total Customers],
			    0
			)
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: 29fda56d-1d45-4e90-b1e2-5a5442823256

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average days since last order across customers.
	measure 'Avg Recency Days' =
			
			AVERAGE ( dim_Customer[Recency Days] )
		formatString: #,##0
		displayFolder: 01 - Core KPIs
		lineageTag: 58ad69cb-a3ec-4f15-8ae2-eb328a14c005

	/// Average number of orders per customer (frequency RFM input).
	measure 'Avg Frequency' =
			
			AVERAGE ( dim_Customer[Order Count] )
		formatString: #,##0
		displayFolder: 01 - Core KPIs
		lineageTag: 77e805fb-be3b-4cd2-b3b6-67dcbcb2dafa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average total spend per customer (monetary RFM input).
	measure 'Avg Monetary' =
			
			AVERAGE ( dim_Customer[Total Spend] )
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: be1e02a6-8844-4058-b879-a189bbb07172

	/// Average Recency (R) score across customers; 1–5 NTILE scale, higher = more recent.
	measure 'Avg R Score' =
			
			AVERAGE ( dim_Customer[R Score] )
		formatString: 0.00
		displayFolder: 02 - RFM Scores
		lineageTag: 56225373-0fbe-470a-ab4d-064fc2f7b731

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average Frequency (F) score across customers; 1–5 NTILE scale, higher = more frequent.
	measure 'Avg F Score' =
			
			AVERAGE ( dim_Customer[F Score] )
		formatString: 0.00
		displayFolder: 02 - RFM Scores
		lineageTag: 71301511-51f7-4a96-a026-ae9f38117446

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average Monetary (M) score across customers; 1–5 NTILE scale, higher = more spend.
	measure 'Avg M Score' =
			
			AVERAGE ( dim_Customer[M Score] )
		formatString: 0.00
		displayFolder: 02 - RFM Scores
		lineageTag: f928d2f4-641e-489b-ad7e-d7dfbe40879b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average customer health score (R+F+M combined), out of 15.
	measure 'Avg Health Score' =
			
			AVERAGE ( dim_Customer[Health Score] )
		formatString: 0.0 "/ 15"
		displayFolder: 02 - RFM Scores
		lineageTag: 7d30ec94-58b3-42b9-bb01-6d35dc7cd89a

		annotation PBI_FormatHint = {"isCustom":true}

	/// Share of ordering customers in the current segment vs all ordering customers.
	measure 'Segment % of Total' =
			
			VAR SegmentCount =
			    CALCULATE (
			        COUNTROWS ( dim_Customer ),
			        NOT ISBLANK ( dim_Customer[Order Count] )
			    )
			VAR TotalCount =
			    CALCULATE (
			        COUNTROWS ( dim_Customer ),
			        ALL ( dim_Customer ),
			        NOT ISBLANK ( dim_Customer[Order Count] )
			    )
			RETURN
			    DIVIDE (
			        SegmentCount,
			        TotalCount,
			        0
			    )
		formatString: 0.00%
		displayFolder: 03 - Segment Analysis
		lineageTag: 7d0d4543-b44a-4a90-b7a5-f87db47dbdc7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Current segment's share of total customer spend.
	measure 'Revenue % of Total' =
			
			VAR SegmentRevenue =
			    SUM ( dim_Customer[Total Spend] )
			VAR TotalRevenue =
			    CALCULATE (
			        SUM ( dim_Customer[Total Spend] ),
			        ALL ( dim_Customer )
			    )
			RETURN
			    DIVIDE (
			        SegmentRevenue,
			        TotalRevenue,
			        0
			    )
		formatString: 0.00%
		displayFolder: 03 - Segment Analysis
		lineageTag: 0196b41c-c569-4fdc-b90d-16422dc0fd32

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total spend of customers in the At Risk and Hibernating segments.
	measure 'Revenue at Risk' =
			
			CALCULATE (
			    SUM ( dim_Customer[Total Spend] ),
			    dim_Customer[Segment]
			        IN {
			            "At Risk",
			            "Hibernating"
			        }
			)
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 03 - Segment Analysis
		lineageTag: 4f673189-f4ce-4043-8765-a0cc6fe05688

	/// Spend from customers active within the last 90 days.
	measure 'Revenue Active' =
			
			CALCULATE (
			    SUM ( dim_Customer[Total Spend] ),
			    dim_Customer[Recency Days] <= 90
			)
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 04 - Time Intelligence (Recency Buckets)
		lineageTag: 80277715-e07f-42a3-b819-71cde6e5bf8f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Spend from customers with recency of 91–180 days.
	measure 'Revenue Cooling' =
			
			CALCULATE (
			    SUM ( dim_Customer[Total Spend] ),
			    dim_Customer[Recency Days] > 90
			        && dim_Customer[Recency Days] <= 180
			)
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 04 - Time Intelligence (Recency Buckets)
		lineageTag: 3e18133c-07c7-431b-91e3-827dad96c767

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Spend from customers with recency over 180 days.
	measure 'Revenue Dormant' =
			
			CALCULATE (
			    SUM ( dim_Customer[Total Spend] ),
			    dim_Customer[Recency Days] > 180
			)
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 04 - Time Intelligence (Recency Buckets)
		lineageTag: e3aae03a-8f0a-439d-925f-bcea7814b109

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Projected recovered revenue: at-risk spend times the selected reactivation rate.
	measure 'What-If Revenue Impact' =
			
			VAR AtRiskRev =
			    CALCULATE (
			        SUM ( dim_Customer[Total Spend] ),
			        dim_Customer[Segment]
			            IN {
			                "At Risk",
			                "Hibernating"
			            }
			    )
			VAR Rate =
			    SELECTEDVALUE (
			        'Reactivation Rate'[Reactivation Rate],
			        10
			    ) / 100
			RETURN
			    AtRiskRev * Rate
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 05 - Dynamic & What-If
		lineageTag: d5521e1f-3eb7-43b6-8c4b-6b52544a2182

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Returns the KPI chosen in the dim_KPI_Selector slicer via SWITCH; format inherited from the selected measure.
	measure 'Dynamic KPI Selector' =
			
			VAR Selected =
			    SELECTEDVALUE (
			        dim_KPI_Selector[KPI],
			        "Total Revenue"
			    )
			RETURN
			    SWITCH (
			        Selected,
			        "Total Revenue", [Total Revenue],
			        "Total Customers", [Total Customers],
			        "Average Order Value", [Avg Order Value],
			        "Average Recency Days", [Avg Recency Days],
			        "Revenue at Risk", [Revenue at Risk],
			        [Total Revenue]
			    )
		displayFolder: 05 - Dynamic & What-If
		lineageTag: cc8df1f6-cf08-4c78-ac86-c62abc92d1ca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Status text (Healthy / Monitor / Critical) derived from the average Health Score.
	measure 'Health Indicator' =
			
			VAR Score =
			    AVERAGE ( dim_Customer[Health Score] )
			RETURN
			    SWITCH (
			        TRUE (),
			        Score >= 11, "● Healthy",
			        Score >= 7, "◐ Monitor",
			        "○ Critical"
			    )
		displayFolder: 06 - Formatting & Regional
		lineageTag: f24d00f6-2062-46ef-8efc-f87ad9402310

	/// Average revenue per ordering customer, evaluated within the current country context.
	measure 'ARPU by Country' =
			
			DIVIDE (
			    SUM ( dim_Customer[Total Spend] ),
			    CALCULATE (
			        COUNTROWS ( dim_Customer ),
			        NOT ISBLANK ( dim_Customer[Order Count] )
			    ),
			    0
			)
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 06 - Formatting & Regional
		lineageTag: 4c092dcc-cf45-4a1d-94fc-349b9f15d2ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Selected country's share of total customer spend.
	measure 'Country Revenue Share' =
			
			DIVIDE (
			    SUM ( dim_Customer[Total Spend] ),
			    CALCULATE (
			        SUM ( dim_Customer[Total Spend] ),
			        ALL ( dim_Customer )
			    ),
			    0
			)
		formatString: 0.00%
		displayFolder: 06 - Formatting & Regional
		lineageTag: a03f95c6-0685-4106-afc6-47b8691ff0f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Hex color per segment (SWITCH fallback); prefer the dim_Segment[SegmentColor] column for conditional formatting, do not use both on one visual.
	measure 'Segment Color' =
			
			SWITCH (
			    SELECTEDVALUE ( dim_Customer[Segment] ),
			    "Champions", "#4A7AA0",
			    "Loyal Customers", "#7BA8B8",
			    "Potential Loyalists", "#8FA87E",
			    "Recent Customers", "#D4A762",
			    "At Risk", "#A05A55",
			    "Hibernating", "#A5A29A",
			    "#94A3B8"
			)
		displayFolder: 06 - Formatting & Regional
		lineageTag: b1dd26eb-576c-4894-9ad0-48832a062fde

	/// Order-grain distinct order count from sales_curated[Order ID]; not slice-able by dim_Product (no relationship path); do not place on a product axis.
	measure 'Distinct Orders' =
			
			DISTINCTCOUNT ( sales_curated[Order ID] )
		formatString: #,##0
		displayFolder: 01 - Core KPIs
		lineageTag: c7cee83f-8a00-41f5-9790-5d3bee388ed0

	/// Total order-grain gross profit from sales_curated; the P&L profit figure (EUR).
	measure 'Total Profit' =
			
			SUM ( sales_curated[Order Profit] )
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: 44e2e694-8394-489c-b49d-d59a51f77217

	/// Revenue-weighted margin: Total Profit / Total Revenue; P&L truth, never average of percentages.
	measure 'Profit Margin %' =
			
			DIVIDE (
			    [Total Profit],
			    [Total Revenue],
			    0
			)
		formatString: 0.00%
		displayFolder: 01 - Core KPIs
		lineageTag: 828d7382-58dc-49e2-8560-93bd20b21132

	/// Dynamic Page 1 chart title with live month count from sales_curated[Source Month].
	measure 'Revenue Trend Chart Title' =
			
			"Weekly Revenue Trend Across "
			    & DISTINCTCOUNT ( sales_curated[Source Month] )
			    & " Months"
		displayFolder: 06 - Formatting & Regional
		lineageTag: 6325ebe8-f042-412f-95f9-4d291e5db17f

	/// Dynamic Page 1 subtitle with live rolling month count.
	measure 'Subtitle Page 1' =
			
			"Kupferkanne – D2C E-commerce · 9 European markets · Rolling "
			    & DISTINCTCOUNT ( sales_curated[Source Month] )
			    & " months"
		displayFolder: 06 - Formatting & Regional
		lineageTag: d675d5e4-55c3-4696-a70c-01092b4406ec

	/// Text label naming the KPI currently selected in dim_KPI_Selector.
	measure 'Dynamic KPI Label' =
			
			SELECTEDVALUE (
			    dim_KPI_Selector[KPI],
			    "Total Revenue"
			)
		displayFolder: 05 - Dynamic & What-If
		lineageTag: 2660f964-e1a9-4876-921d-8e29254effea

	/// Static axis caption for the RFM Score Selector Field Parameter (Recency).
	measure 'R Label' =
			
			"R"
		displayFolder: 06 - Formatting & Regional
		lineageTag: 03cf0f79-27a3-48a0-9392-81f81c28892b

	/// Static axis caption for the RFM Score Selector Field Parameter (Monetary).
	measure 'M Label' =
			
			"M"
		displayFolder: 06 - Formatting & Regional
		lineageTag: f7611bd9-444e-4a53-b702-9ac8b2d975e5

	/// Static axis caption for the RFM Score Selector Field Parameter (Frequency).
	measure 'F Label' =
			
			"F"
		displayFolder: 06 - Formatting & Regional
		lineageTag: 491a01f9-dcfd-4b9a-8cdf-e690b05a6458

	/// Distinct product count from dim_Product.
	measure 'Total Products' =
			
			DISTINCTCOUNT ( dim_Product[Product ID] )
		formatString: #,##0
		displayFolder: 01 - Core KPIs
		lineageTag: 6afb354c-1c5b-4578-9b1d-9fc326b5b67e

	/// Line revenue of the highest-revenue brand in the current filter context.
	measure 'Top Brand Revenue' =
			
			MAXX (
			    VALUES ( dim_Product[Brand] ),
			    [Line Revenue]
			)
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: ab046c17-7e49-4989-84b1-f626e69b9253

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Equal-weight average of per-brand margins; benchmark semantic, not P&L – label as Average Brand Margin.
	measure 'Avg Brand Margin %' =
			
			AVERAGEX (
			    VALUES ( dim_Product[Brand] ),
			    [Line Margin %]
			)
		formatString: 0.00%
		displayFolder: 01 - Core KPIs
		lineageTag: 3f718105-6299-421f-8728-5298004297a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Line revenue of the highest-revenue product category in context.
	measure 'Top Category Revenue' =
			
			MAXX (
			    VALUES ( dim_Product[Product Category] ),
			    [Line Revenue]
			)
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: 8d6a8337-2079-4809-a95a-69339ad91df5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Dynamic Page 3 subtitle with live product and brand counts.
	measure 'Subtitle Page 3' =
			
			"Profitability across "
			    & [Total Products]
			    & " products and "
			    & [Total Brands]
			    & " brands"
		displayFolder: 06 - Formatting & Regional
		lineageTag: 458efd47-dc70-4f08-a853-b9c5f88dd665

	/// Name of the highest-revenue product category; revenue ties resolve alphabetically.
	measure 'Top Category Name' =
			
			VAR TopCategory =
			    TOPN (
			        1,
			        VALUES ( dim_Product[Product Category] ),
			        [Line Revenue], DESC,
			        dim_Product[Product Category], ASC
			    )
			RETURN
			    MAXX (
			        TopCategory,
			        dim_Product[Product Category]
			    )
		displayFolder: 01 - Core KPIs
		lineageTag: 1a023e34-320e-4b22-9e58-bf013592f9c5

	/// Dynamic Page 2 subtitle with live segment count.
	measure 'Subtitle Page 2' =
			
			"RFM profile comparison across "
			    & DISTINCTCOUNT ( dim_Segment[Segment] )
			    & " segments"
		displayFolder: 06 - Formatting & Regional
		lineageTag: 50e22469-7d24-4b4d-8799-fd8fd3a7749a

	/// Name of the highest-revenue brand; revenue ties resolve alphabetically.
	measure 'Top Brand Name' =
			
			VAR TopBrand =
			    TOPN (
			        1,
			        VALUES ( dim_Product[Brand] ),
			        [Line Revenue], DESC,
			        dim_Product[Brand], ASC
			    )
			RETURN
			    MAXX (
			        TopBrand,
			        dim_Product[Brand]
			    )
		displayFolder: 01 - Core KPIs
		lineageTag: 4b359491-7e06-41d1-8ba9-31a29d578273

	/// Line-grain gross profit from v_items_for_bi; building block for brand/category measures.
	measure 'Line Profit' =
			
			SUM ( v_items_for_bi[Line Profit] )
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: ae7e57d7-9ca3-4da8-99f6-12104911f27e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Line-grain net revenue from v_items_for_bi; building block for brand/category measures, not visual-bound.
	measure 'Line Revenue' =
			
			SUM ( v_items_for_bi[Line Net Amount] )
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: 54ed303b-0e85-4fe0-9316-a99c7e683927

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Line-grain margin: Line Profit / Line Revenue.
	measure 'Line Margin %' =
			
			DIVIDE (
			    [Line Profit],
			    [Line Revenue],
			    0
			)
		formatString: 0.00%
		displayFolder: 01 - Core KPIs
		lineageTag: 94e4eb48-07a3-43df-bfc5-9aec3cb739fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// QA invariant: Total Revenue minus Line Revenue; expected 0 when grains agree.
	measure 'Grain Reconciliation' =
			
			[Total Revenue] - [Line Revenue]
		formatString: "€"#,##0.00;-"€"#,##0.00
		displayFolder: 01 - Core KPIs
		lineageTag: 59f9cdea-addd-49c8-a701-91153fb99226

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Distinct brand count from dim_Product.
	measure 'Total Brands' =
			
			DISTINCTCOUNT ( dim_Product[Brand] )
		formatString: #,##0
		displayFolder: 01 - Core KPIs
		lineageTag: 651b4502-be94-4783-827b-0c30a3a3fc73

	/// Line-grain unit volume from v_items_for_bi; explicit SUM because F006 disables implicit aggregation on Quantity.
	measure 'Line Quantity' =
			
			SUM ( v_items_for_bi[Quantity] )
		formatString: #,##0
		displayFolder: 01 - Core KPIs
		lineageTag: ff617895-baec-4674-926a-44ee836c100b

	/// Dynamic Page 3 combo chart title naming the top brand and its compact revenue; bound via fx (Field value); text measure, no FormatString by design.
	measure 'Combo Chart Title' =
			
			"Brand Revenue x Margin % - top brand "
			    & [Top Brand Name]
			    & " drives "
			    & FORMAT ( [Top Brand Revenue], "€#,##0,,.0M" )
		displayFolder: 06 - Formatting & Regional
		lineageTag: 0215e522-d609-4d83-b7ca-851929a13598

	/// Revenue-weighted margin across all brands; flat baseline for the Page 3 brand combo.
	measure 'Margin Baseline' =
			
			CALCULATE (
			    [Line Margin %],
			    REMOVEFILTERS ( dim_Product[Brand] )
			)
		formatString: 0.00%
		displayFolder: 01 - Core KPIs
		lineageTag: 01380a35-493c-4727-bab1-5cda24389ad3

	column x
		isHidden
		formatString: 0
		displayFolder: helpers
		lineageTag: e3f70544-2115-47e3-84d3-d9a09f09653b
		summarizeBy: sum
		isNameInferred
		sourceColumn: [x]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = ROW("x", BLANK())

	annotation PBI_Id = a72d0acece614f1aa6737e225ba8761b

