		lineageTag: 7a658494-621d-45a9-8406-46b63910fe0a

	/// Static Page 3 subtitle for the brand combo chart; data-claim literal, revalidate if margin ranking changes.
	measure 'Subtitle Brand Margin' =
			
			"Eigenmarke leads on margin"
