	/// Drillthrough header "C-10482 · Champions · Erlangen, Germany"; prompts the drill-through gesture when no single customer is in context.
	measure 'Subtitle Page 7' =
			
			VAR HasCustomer =
			    HASONEVALUE ( dim_Customer[Customer ID] )
			RETURN
			    IF (
			        HasCustomer,
			        SELECTEDVALUE ( dim_Customer[Customer ID] )
			            & " · " & SELECTEDVALUE ( dim_Customer[Segment] )
			            & " · " & SELECTEDVALUE ( dim_Customer[City] )
			            & ", " & SELECTEDVALUE ( dim_Customer[Country] ),
			        "Right-click a customer on any page and choose Drill through"
			    )
		displayFolder: 06 - Formatting & Regional
		lineageTag: a01ca6ef-0fca-42be-87d4-67a755cb7266

	/// Single-customer display of dim_Customer[Recency Days]; BLANK unless exactly one customer is in context.
	measure 'Customer Recency Days' =
			
			SELECTEDVALUE ( dim_Customer[Recency Days] )
		formatString: #,##0 "days"
		displayFolder: 02 - RFM Scores
		lineageTag: 9729869c-af5d-418d-bae3-f065797b8329

	/// Single-customer display of dim_Customer[Health Score] (RFM score sum, scale 3-15); BLANK unless exactly one customer is in context.
	measure 'Customer Health Score' =
			
			SELECTEDVALUE ( dim_Customer[Health Score] )
		formatString: 0 "/ 15"
		displayFolder: 02 - RFM Scores
		lineageTag: fdccb68d-2d9e-4f44-95ba-6c665fa46a68

	/// "R5 · F4 · M5" score triplet of the drilled customer; BLANK unless exactly one customer is in context.
	measure 'Customer RFM Label' =
			
			VAR RScore =
			    SELECTEDVALUE ( dim_Customer[R Score] )
			VAR FScore =
			    SELECTEDVALUE ( dim_Customer[F Score] )
			VAR MScore =
			    SELECTEDVALUE ( dim_Customer[M Score] )
			RETURN
			    IF (
			        NOT ISBLANK ( RScore ),
			        "R" & RScore
			            & " · F" & FScore
			            & " · M" & MScore
			    )
		displayFolder: 02 - RFM Scores
		lineageTag: 3c94c0b7-1607-4901-9d6f-405d6b0bace5

	/// Total Revenue over the trailing 12 months ending at the current date context (EUR).
	measure 'Revenue Rolling 12M' =
			
			CALCULATE (
			    [Total Revenue],
			    DATESINPERIOD ( dim_Date[Date], MAX ( dim_Date[Date] ), -12, MONTH )
			)
		formatString: "€"#,##0;-"€"#,##0
		displayFolder: 04 - Time Intelligence
		lineageTag: 8a1aae11-13e9-49a1-a612-40231ae60e1f

	/// YoY change of Total Revenue vs the same period last year; the current open month reads low against a full prior-year month - surface on the Page 1 trend tooltip.
	measure 'Revenue YoY %' =
			
			VAR CurrentRevenue = [Total Revenue]
			VAR PriorRevenue =
			    CALCULATE (
			        [Total Revenue],
			        SAMEPERIODLASTYEAR ( dim_Date[Date] )
			    )
			RETURN
			    DIVIDE ( CurrentRevenue - PriorRevenue, PriorRevenue )
		formatString: 0.0%
		displayFolder: 04 - Time Intelligence
		lineageTag: af2a1c88-dad3-4e14-82d6-f0c5873a92dd

	column x
		isHidden
		formatString: 0
		displayFolder: helpers
		lineageTag: e3f70544-2115-47e3-84d3-d9a09f09653b
		summarizeBy: sum
		isNameInferred
		sourceColumn: [x]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = ROW("x", BLANK())

	annotation PBI_Id = a72d0acece614f1aa6737e225ba8761b

