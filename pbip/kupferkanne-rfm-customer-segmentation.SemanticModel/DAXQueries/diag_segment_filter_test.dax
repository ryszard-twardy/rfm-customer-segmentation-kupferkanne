// Purpose: per-segment revenue under filter context; order-grain vs line-grain per segment.
// Expected: [Grain Reconciliation] is 0 on every row.
// Run: before and after model changes affecting segmentation or grain.

EVALUATE
SELECTCOLUMNS (
    VALUES ( dim_Customer[Segment] ),
    "Segment", dim_Customer[Segment],
    "Total Revenue", [Total Revenue],
    "Line Revenue", [Line Revenue],
    "Customers", [Total Customers],
    "Reconciliation", [Grain Reconciliation]
)
ORDER BY [Total Revenue] DESC