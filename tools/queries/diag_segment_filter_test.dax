EVALUATE
CALCULATETABLE (
    SUMMARIZECOLUMNS (
        dim_SegmentOrder[Segment],
        "Revenue", [Total Revenue],
        "Customers", [Total Customers]
    ),
    dim_SegmentOrder[Segment] IN { "Champions", "Loyal Customers", "Potential Loyalists", "Recent Customers", "At Risk", "Hibernating" }
)
