{# Cover: the decision asked for and the headline finding. Bars scale with the per-1,000 figures. #}
{% set at_risk_bar = 480 %}
<section id="cover" class="slide slide--cover">
<div class="col" style="width:820px;gap:32px">
<p class="label">Leadership decision paper</p>
<h1 class="cover-title">Kupferkanne: win-back discount allocation</h1>
<p class="lead c-heading">Test <span class="c-accent">a {{ v.focus.at_risk.discount_pct | pct(0) }} rate for Hibernating</span> in a controlled pilot with holdouts before the playbook changes.</p>
<div class="col rule-top" style="gap:4px;padding-top:24px">
<p class="caption bold c-heading">Ryszard Twardy, data analyst</p>
<p class="caption">{{ meta.date }}{% if meta.status %} · {{ meta.status }}{% endif %}</p>
<p class="caption"><a href="https://ryszard-twardy.github.io/kupferkanne/">ryszard-twardy.github.io/kupferkanne</a></p>
</div>
</div>
<div class="col" style="flex:1;gap:28px">
<p class="caption">Contribution per €1,000 of discount, at the playbook's rates</p>
<div class="col" style="gap:8px">
<p class="strong c-at-risk">At&#160;Risk</p>
<div class="row" style="align-items:center;gap:20px">
<div class="bg-at-risk" style="width:{{ at_risk_bar }}px;height:72px"></div>
<p class="figure num">{{ v.focus.at_risk.per_1000_eur | eur(0) }}</p>
</div>
</div>
<div class="col" style="gap:8px">
<p class="strong c-hibernating">Hibernating</p>
<div class="row" style="align-items:center;gap:20px">
<div class="bg-hibernating" style="width:{{ (at_risk_bar * v.focus.hibernating.per_1000_eur / v.focus.at_risk.per_1000_eur) | px }}px;height:72px"></div>
<p class="figure num">{{ v.focus.hibernating.per_1000_eur | eur(0) }}</p>
</div>
</div>
<p class="lead c-heading">{{ v.ratios.playbook | times(2) }} as much in {{ at_risk() }}</p>
</div>
{{ foot("Fictional brand, synthetic data. Source: docs/methodology.md") }}
</section>
