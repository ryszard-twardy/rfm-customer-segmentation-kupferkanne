{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/git-hygiene.ps1",
            "timeout": 20,
            "statusMessage": "Checking git hygiene (uncommitted / behind remote)..."
          }
        ]
      }
    ]
  }
}
