# ============================================================
# .gitignore - kupferkanne-rfm-customer-segmentation
# ============================================================

# Working / private folders (NOT for public repo) -----------
_backups/
.checkpoints/
.outputs/
.personal/

# _graphics/        # uncomment if you decide NOT to track graphics

# Logs ------------------------------------------------------
logs/
_sqlfluff_*.txt

# PBI binaries - track only canonical -----------------------
pbix/*
!pbix/Kupferkanne-rfm-customer-segmentation.pbix
*.pbix.bak
PowerBI*-Cache/

# Python / venv ---------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# Secrets ---------------------------------------------------
.env
.env.local
*.json.key
service_account*.json

# OS / editor noise -----------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Temp ------------------------------------------------------
*.tmp
.tmp_*
~$*
*.bak

# Quarto (Phase 4 EDA notebook) -----------------------------
/.quarto/
*_files/
*_cache/

# === Workflow v3 (Ryszard) ===
# .checkpoints/ and .personal/ already declared above

# Claude Code: track shared config + hooks (cross-machine), keep local overrides private
.claude/*
!.claude/settings.json
!.claude/hooks/

# Per-device transient state - not synced anywhere
.scratch/
.backups/

# Spec-Kit caches
.specify/cache/
.specify/state/

# Data / Python (workflow v3 data stack)
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Power BI (workflow v3 data stack)
*.pbix.tmp
*.pbip.tmp
.pbi/
LocalCache/

# Credentials (workflow v3 data stack - variants beyond service_account*.json above)
service-account*.json
credentials*.json
*.pem
# === End workflow v3 additions ===

# Power BI Project (.pbip) - local cache and user settings (machine-local, not source)
**/.pbi/

# PBIP DAX Query View scratch (named or auto-named); promote durable queries to tools/queries/
**/DAXQueries/*.dax

# uv / reproducible Python env (additive; .venv/, __pycache__/, .env already declared above)
*.py[cod]
# Named GCP credential patterns (never blanket *.json - BQ schema JSONs stay tracked)
*-service-account*.json
gcp-credentials*.json